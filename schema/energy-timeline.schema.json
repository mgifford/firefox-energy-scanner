                },
                "lighthouse": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "selectorMatches": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "experiments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "available": {
                        "type": "boolean"
                      },
                      "why": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "available",
                      "why"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "instance",
                "type",
                "signature",
                "selector",
                "page",
                "reach",
                "scripts",
                "resources",
                "evidence",
                "classes",
                "lighthouse",
                "experiments"
              ],
              "additionalProperties": false
            }
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "inline": {
                  "type": "boolean"
                },
                "resource": {
                  "type": "string"
                },
                "loadedBy": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "functions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "line": {
