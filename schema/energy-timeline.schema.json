              "stacks",
              "cpuTime"
            ],
            "additionalProperties": false
          },
          "activity": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "process": {
                  "type": "string",
                  "enum": [
                    "browser",
                    "page",
                    "gpu",
                    "other",
                    "unknown"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ms": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Time within the interval covered by at least one such marker: overlaps counted once."
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind",
                "count",
                "ms",
                "names"
              ],
              "additionalProperties": false
            }
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "functionName": {
                  "type": "string"
                },
                "line": {
                  "type": "number"
                },
                "samples": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "process": {
                  "type": "string",
                  "enum": [
                    "browser",
                    "page",
                    "gpu",
                    "other",
                    "unknown"
                  ]
