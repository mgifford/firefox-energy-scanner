                "cpuMs": {
                  "type": "number"
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sessionShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "category",
                "cpuMs",
                "share"
              ],
              "additionalProperties": false
            }
          },
          "categoryBasis": {
            "type": "string",
