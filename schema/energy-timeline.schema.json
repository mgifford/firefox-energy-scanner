                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "class": {
                        "type": "string",
                        "enum": [
                          "observed-window",
                          "profiler-correlation",
                          "resource-association",
                          "cross-run-trace",
                          "direct-node",
