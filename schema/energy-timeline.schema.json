{
  "$id": "https://github.com/mgifford/firefox-energy-scanner/schema/energy-timeline.schema.json",
  "title": "Firefox Energy Scanner energy timeline, intervals and leads",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timeline": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "energy-timeline/1"
        },
        "originEpochMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "binMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requestedBinMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "resolution": {
          "type": "object",
          "properties": {
            "sampleIntervalMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "counterUpdateMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "minimumBinMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "supportedBinsMs": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "required": [
            "sampleIntervalMs",
            "counterUpdateMs",
            "minimumBinMs",
            "supportedBinsMs"
          ],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "enum": [
            "process",
            "cpu-package",
            "system"
          ]
        },
        "basis": {
          "type": "string"
        },
        "counters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "samples": {
          "type": "object",
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "excluded": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "used",
            "excluded"
          ],
          "additionalProperties": false
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "number"
              },
              "endMs": {
                "type": "number"
              },
              "counter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs",
              "counter"
            ],
            "additionalProperties": false
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "baseline",
                  "loading",
                  "stabilizing",
                  "idle",
                  "interaction",
                  "unmeasured"
                ]
              },
              "step": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "run": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "warmup": {
                "type": "boolean"
              },
              "startMs": {
                "type": "number"
              },
              "endMs": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "step",
              "label",
              "warmup",
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "startMs": {
                "type": "number"
              },
              "endMs": {
                "type": "number"
              },
              "samples": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "energyJ": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Energy read in the bin, J. Null when no sample was read: never zero for \"not measured\"."
              },
              "averagePowerW": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Energy over the bin width, W. Null when there is no energy, or it reaches back beyond the bin."
              },
              "phase": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "no-samples",
                    "lumped",
                    "unit-missing",
                    "phase-boundary",
                    "first-sample"
                  ]
                }
              }
            },
            "required": [
              "index",
              "startMs",
              "endMs",
              "samples",
              "energyJ",
              "averagePowerW"
            ],
            "additionalProperties": false
          }
        },
        "profilerFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "samplingIntervalMs": {
          "type": "number"
        },
        "scenario": {
          "type": "string"
        },
        "run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "originEpochMs",
        "durationMs",
        "binMs",
        "requestedBinMs",
        "resolution",
        "scope",
        "basis",
        "counters",
        "samples",
        "gaps",
        "phases",
        "bins",
        "profilerFeatures",
        "warnings",
        "method"
      ],
      "additionalProperties": false
    },
    "spikes": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "robust-threshold-v1"
        },
        "statement": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "enum": [
                "auto",
                "baseline",
                "quiet",
                "rolling"
              ]
            },
            "k": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minDurationMs": {
              "type": "number",
              "minimum": 0
            },
            "mergeGapMs": {
              "type": "number",
              "minimum": 0
            },
            "sustainedMs": {
              "type": "number",
              "minimum": 0
            },
            "quietFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "rollingWindowMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minRiseW": {
              "type": "number",
              "minimum": 0
            },
            "minReferenceBins": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "binMs": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "reference",
            "k",
            "minDurationMs",
            "mergeGapMs",
            "sustainedMs",
            "quietFraction",
            "rollingWindowMs",
            "minRiseW",
            "minReferenceBins",
            "binMs"
          ],
          "additionalProperties": false
        },
        "reference": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "baseline-window",
                "quiet-bins",
                "rolling-median"
              ]
            },
            "powerW": {
              "type": "number"
            },
            "spreadW": {
              "type": "number",
              "minimum": 0
            },
            "spreadFrom": {
              "type": "string",
              "enum": [
                "mad",
                "quantum",
                "none"
              ]
            },
            "bins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "powerW",
            "spreadW",
            "spreadFrom",
            "bins"
          ],
          "additionalProperties": false
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^spike-\\d+$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "startMs": {
                "type": "number"
              },
              "endMs": {
                "type": "number"
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "bins": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "peakPowerW": {
                "type": "number",
                "minimum": 0
              },
              "peakAtMs": {
                "type": "number"
              },
              "meanPowerW": {
                "type": "number",
                "minimum": 0
              },
              "energyJ": {
                "type": "number",
                "minimum": 0
              },
              "excessEnergyJ": {
                "type": "number",
                "minimum": 0
              },
              "referenceW": {
                "type": "number"
              },
              "thresholdW": {
                "type": "number"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "brief-peak",
                  "sustained"
                ]
              },
              "phases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "outside-measured-steps",
                    "crosses-phase-boundary",
                    "includes-lumped-bins",
                    "warmup",
                    "machine-wide-scope",
                    "during-baseline",
                    "whole-phase"
                  ]
                }
              }
            },
            "required": [
              "id",
              "rank",
              "startMs",
              "endMs",
              "durationMs",
              "bins",
              "peakPowerW",
              "meanPowerW",
              "energyJ",
              "excessEnergyJ",
              "referenceW",
              "thresholdW",
              "shape",
              "phases",
              "steps",
              "flags"
            ],
            "additionalProperties": false
          }
        },
        "topBins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "startMs": {
                "type": "number"
              },
              "powerW": {
                "type": "number"
              },
              "phase": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "startMs",
              "powerW"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "method",
        "statement",
        "settings",
        "reference",
        "intervals",
        "topBins",
        "warnings"
      ],
      "additionalProperties": false
    },
