{
  "name": "firefox-energy-scanner",
  "version": "0.1.0",
  "description": "Measure observed client-side browser energy and modelled CO2e for websites and authenticated Drupal admin interfaces.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "web-energy": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "web-energy": "node --experimental-strip-types src/cli/index.ts",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tgwf/co2": "^0.19.0",
    "playwright": "^1.57.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
