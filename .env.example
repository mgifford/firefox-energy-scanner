# Copy this file to .env and fill in what you use. .env is in .gitignore,
# so it never reaches the repository. The CLI reads .env from the directory
# you run it in; a variable already set in your shell wins.

# Chrome UX Report API key, for --crux, --crux-pages and --popular.
# Create one at https://console.cloud.google.com/apis/library/chromeuxreport.googleapis.com
# and restrict it to the Chrome UX Report API. See docs/crux.md#the-api-key.
CRUX_API_KEY=

# Drupal login, only for --authenticated scans of your own site.
# DRUPAL_USERNAME=
# DRUPAL_PASSWORD=
